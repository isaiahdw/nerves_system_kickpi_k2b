# fw_printenv and fw_setenv configuration
#
# This must match UBOOT_ENV_OFFSET/UBOOT_ENV_COUNT in
# fwup_include/fwup-common.conf (sector 8192 = 4 MB = 0x400000, 128 KB)
# and CONFIG_ENV_OFFSET/CONFIG_ENV_SIZE in uboot/fragment.config.

# rootdisk0 is erlinit's symlink to the disk holding the root filesystem,
# so the environment follows the boot medium (SD or eMMC).
# Device name	Device offset	Env. size	Flash sector size	Number of sectors
/dev/rootdisk0	0x400000	0x20000		0x200			256
