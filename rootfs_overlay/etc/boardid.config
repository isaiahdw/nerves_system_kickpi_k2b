# boardid.config

# Read the serial number from the U-boot environment block. The variable
# "nerves_serial_number" is the desired variable to use. "serial_number" is
# checked as a backup.
-b uboot_env -u nerves_serial_number
-b uboot_env -u serial_number

# The H618's SID eFuse (16-byte chip id) through the nvmem sysfs file.
-b binfile -f /sys/bus/nvmem/devices/sunxi-sid0/nvmem -l 16

# Fall back to the MAC address of the first network interface.
-b macaddr
