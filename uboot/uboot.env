# Nerves U-Boot environment for the KickPi K2B (Allwinner H618)
#
# Compiled into uboot-env.bin and written raw at 4 MB (0x400000) on the
# boot medium — see fwup_include/fwup-common.conf and
# rootfs_overlay/etc/fw_env.config.
#
# U-Boot (mainline v2026.01, CONFIG_ENV_IS_IN_MMC with ENV_OFFSET=0x400000;
# CONFIG_ENV_MMC_DEVICE_INDEX=0 is the default MMC device, but sunxi's
# mmc_get_env_dev() follows the boot medium, so the env is read from and
# written to whichever medium booted; see uboot/fragment.config) loads this
# environment and runs `bootcmd` below, which implements A/B slot selection
# with automatic revert of unvalidated firmware.
#
# NOTE: loading a saved environment REPLACES U-Boot's built-in defaults, so
# the memory-layout variables from include/configs/sunxi-common.h (v2026.01,
# arm64, DRAM at 0x40000000) are reproduced here. The distro-boot variable
# set is not; the sysboot fallback at the end of bootcmd covers the same
# extlinux path directly. If the saved env is missing or corrupt entirely,
# U-Boot's compiled-in bootstd default (v2026.01 sunxi is on bootstd, not
# distro_bootcmd) boots extlinux/extlinux.conf from the FAT partition via its
# extlinux bootmeth — automatic recovery either way.

# If every boot attempt returns (kernel could not be loaded/booted from
# either the Nerves env path or the extlinux fallback), reset instead of
# dropping to an idle U-Boot prompt. nerves_init runs first on the next
# boot and reverts an unvalidated firmware to the other slot, so a bad
# slot self-heals rather than hanging. The recovery button (FEL) is the
# escape hatch if both slots are bad.
bootcmd=run nerves_init nerves_boot; sysboot mmc ${mmc_bootdev}:1 any ${scriptaddr} /extlinux/extlinux.conf; echo "*** all boot paths failed - resetting to retry / revert ***"; sleep 5; reset

# From sunxi-common.h (v2026.01, ARM64 layout, SDRAM_OFFSET base 0x40000000)
bootm_size=0xa000000
kernel_addr_r=0x40080000
kernel_comp_addr_r=0x44000000
kernel_comp_size=0xb000000
fdt_addr_r=0x4fa00000
scriptaddr=0x4fc00000
pxefile_addr_r=0x4fd00000
fdtoverlay_addr_r=0x4fe00000
ramdisk_addr_r=0x4ff00000

#
# Nerves variables
#

nerves_fw_active=a

# Validation is performed by nerves_runtime's startup guard once all OTP
# applications start (autovalidate=0). If a newly-installed firmware fails
# to reach that point before the next boot, nerves_init reverts to the
# previous slot.
nerves_fw_autovalidate=0

# Set to 1 at factory-flash time (fwup complete) since that firmware is
# implicitly trusted.
nerves_fw_validated=1

# 0 on the first boot after an install; U-Boot sets it to 1 so a second
# boot without validation triggers the revert.
nerves_fw_booted=0

nerves_revert=\
    if test ${nerves_fw_active} = "a"; then\
        echo "Reverting to firmware slot B";\
        setenv nerves_fw_active "b";\
    else\
        echo "Reverting to firmware slot A";\
        setenv nerves_fw_active "a";\
    fi

# mmc_bootdev is set by U-Boot from the boot ROM's boot source: 0 = SD,
# 1 = eMMC. The env itself follows the boot device too
# (mmc_get_env_dev in board/sunxi/board.c), so one image boots from
# either medium; the Linux device differs (mmc0 alias = SD, mmc2 =
# eMMC).
nerves_init=\
    if test ${nerves_fw_booted} = 1; then\
        if test ${nerves_fw_validated} = 0; then\
            run nerves_revert;\
            setenv nerves_fw_validated 1;\
            saveenv;\
        fi;\
    else\
        setenv nerves_fw_booted 1;\
        if test ${nerves_fw_autovalidate} = 1; then\
            setenv nerves_fw_validated 1;\
        fi;\
        saveenv;\
    fi;\
    setenv bootfile Image.${nerves_fw_active};\
    setenv fdtfile sun50i-h618-kickpi-k2b.${nerves_fw_active}.dtb;\
    if test ${mmc_bootdev} = 1; then\
        setenv uenv_disk /dev/mmcblk2;\
    else\
        setenv uenv_disk /dev/mmcblk0;\
    fi;\
    if test ${nerves_fw_active} = "a"; then\
        setenv uenv_root ${uenv_disk}p2;\
    else\
        setenv uenv_root ${uenv_disk}p3;\
    fi

console=ttyS0,115200
cmdline=

nerves_setargs=setenv bootargs console=${console} console=tty1 root=${uenv_root} rootfstype=squashfs rootwait ${cmdline}

# booti automatically adds a chosen/kaslr-seed to the device tree from
# U-Boot's RNG device — here the SMCCC TRNG (CONFIG_RNG_SMCCC_TRNG),
# served by BL31's CE TRNG driver. No explicit kaslrseed command is
# needed (and it would fail with FDT_ERR_NOSPACE against the tightly
# sized load buffer); booti resizes the DT and injects the seed itself.
# If the RNG device is absent the seed is simply omitted and the kernel
# boots with KASLR disabled — safe either way.
nerves_boot=\
    load mmc ${mmc_bootdev}:1 ${kernel_addr_r} ${bootfile};\
    load mmc ${mmc_bootdev}:1 ${fdt_addr_r} ${fdtfile};\
    fdt addr ${fdt_addr_r};\
    run nerves_setargs;\
    booti ${kernel_addr_r} - ${fdt_addr_r}
