# Nerves environment location. The Nerves A/B state lives in a raw U-Boot
# environment at 4 MB (0x400000), written by fwup and read back by
# fw_printenv on the target. This must match UBOOT_ENV_OFFSET/UBOOT_ENV_COUNT
# in fwup_include/fwup-common.conf and rootfs_overlay/etc/fw_env.config.
#
# CONFIG_ENV_MMC_DEVICE_INDEX is only the compiled default MMC device;
# sunxi's mmc_get_env_dev() (board/sunxi/board.c) overrides it to the medium
# the boot ROM booted from, so the environment follows the boot medium (SD
# or eMMC) rather than being pinned to a device.
#
# sunxi defaults to a "uboot.env" file on the FAT partition; that copy
# would shadow this one, so it is turned off.
# CONFIG_ENV_IS_IN_FAT is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_OFFSET=0x400000
CONFIG_ENV_SIZE=0x20000
CONFIG_ENV_MMC_DEVICE_INDEX=0

# `ums 0 mmc 1` exposes the eMMC as USB mass storage for factory
# flashing over FEL (sunxi-fel loads this U-Boot into RAM, fwup on the
# host writes the exposed disk). The sunxi board code sets fel_booted=1
# when U-Boot was loaded over FEL, so preboot starts UMS automatically —
# no serial console needed to flash.
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_USB_FUNCTION_MASS_STORAGE=y
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="if test \"$fel_booted\" = \"1\"; then ums 0 mmc 1; fi"

# RNG device backed by BL31's SMCCC TRNG (the CE TRNG driver in
# tfa/patches). This gives `kaslrseed` a seed source; without the
# matching TF-A build it stays absent and kaslrseed is a no-op.
# ARM_SMCCC_FEATURES makes the PSCI driver probe and bind the SMCCC
# services BL31 advertises — without it RNG_SMCCC_TRNG compiles but never
# binds, and kaslrseed reports "No RNG device".
CONFIG_ARM_SMCCC_FEATURES=y
CONFIG_RNG_SMCCC_TRNG=y

# Arm the SoC watchdog for the whole boot, not just once nerves_heart runs in
# userspace. U-Boot's DM watchdog (WDT_SUNXI) autostarts the sunxi watchdog at
# init and services it while U-Boot runs; the kernel then adopts the already-
# running watchdog (CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED + the sunxi_wdt adopt
# patch) and keeps it alive until userspace opens /dev/watchdog. A hang before
# nerves_heart -- e.g. an unvalidated OTA whose rootfs never mounts -- then
# trips the watchdog; the next boot reverts it when the saved environment is
# intact. HW timeout 16s.
CONFIG_WDT=y
CONFIG_WDT_SUNXI=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=16000



