From: Isaiah <isaiahdw@gmail.com>
Subject: [PATCH] arm64: dts: allwinner: add KickPi K2B board

Allwinner H618 SBC, board revision 2.2: AXP313a PMIC, Maxio MAE0621A
RGMII gigabit PHY, eMMC, SD, Seekwave VS6621S SDIO WiFi/BT, USB-C
OTG. Device tree derived from the Armbian board support by Patrick
Yavitz, reduced to mainline nodes, with rev 2.2 fixups (PHY reset
settle, DDR3L rail held at its training voltage).

---
diff -Nur a/arch/arm64/boot/dts/allwinner/Makefile b/arch/arm64/boot/dts/allwinner/Makefile
--- a/arch/arm64/boot/dts/allwinner/Makefile	2026-08-09 12:52:10
+++ b/arch/arm64/boot/dts/allwinner/Makefile	2026-08-09 12:52:10
@@ -46,6 +46,7 @@
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h616-bigtreetech-pi.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h616-orangepi-zero2.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h616-x96-mate.dtb
+dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h618-kickpi-k2b.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h618-longanpi-3h.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h618-orangepi-zero2w.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h618-orangepi-zero3.dtb
diff -Nur a/arch/arm64/boot/dts/allwinner/sun50i-h618-kickpi-k2b.dts b/arch/arm64/boot/dts/allwinner/sun50i-h618-kickpi-k2b.dts
--- a/arch/arm64/boot/dts/allwinner/sun50i-h618-kickpi-k2b.dts	1969-12-31 17:00:00
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h618-kickpi-k2b.dts	2026-08-09 12:52:10
@@ -0,0 +1,404 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * KickPi K2B rev 2.2 (Allwinner H618, DDR3L, eMMC, Seekwave WiFi/BT)
+ *
+ * Derived from the Armbian board support by Patrick Yavitz
+ * <pyavitz@gmail.com>, reduced to the nodes present in mainline.
+ */
+
+/dts-v1/;
+
+#include "sun50i-h616.dtsi"
+#include "sun50i-h616-cpu-opp.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "KickPi K2B";
+	compatible = "kickpi,k2b", "allwinner,sun50i-h618";
+
+	aliases {
+		ethernet0 = &emac0;
+		mmc0 = &mmc0;
+		rtc0 = &ext_rtc;
+		rtc1 = &rtc;
+		mmc1 = &mmc1;
+		mmc2 = &mmc2;
+		serial0 = &uart0;
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
+	gpio-keys-polled {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		button-recovery {
+			label = "recovery";
+			linux,code = <KEY_VENDOR>;
+			gpios = <&pio 2 2 GPIO_ACTIVE_LOW>; /* PC2 */
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-0 {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&pio 8 16 GPIO_ACTIVE_HIGH>; /* PI16 */
+			linux,default-trigger = "heartbeat";
+		};
+	};
+
+	reg_usb_vbus: regulator-usb-vbus {
+		/* Separate discrete regulator for the USB ports */
+		compatible = "regulator-fixed";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-name = "usb-vbus";
+		vin-supply = <&reg_vcc5v>;
+	};
+
+	reg_vcc5v: regulator-vcc5v {
+		/* Board wide 5V supply directly from the USB-C socket */
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-name = "vcc-5v";
+	};
+
+	sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		clocks = <&rtc CLK_OSC32K_FANOUT>;
+		clock-names = "ext_clock";
+		pinctrl-0 = <&x32clk_fanout_pin>;
+		pinctrl-names = "default";
+		post-power-on-delay-ms = <100>;
+		power-off-delay-us = <5000000>;
+		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>, /* PG18 */
+			      <&pio 6 19 GPIO_ACTIVE_LOW>; /* PG19 */
+	};
+};
+
+&codec {
+	status = "okay";
+	allwinner,audio-routing = "Line Out", "LINEOUT";
+};
+
+&cpu0 {
+	cpu-supply = <&reg_dcdc2>;
+};
+
+&emac0 {
+	status = "okay";
+	pinctrl-0 = <&ext_rgmii_pins>;
+	pinctrl-names = "default";
+	phy-mode = "rgmii";
+	phy-handle = <&ext_rgmii_phy>;
+	phy-supply = <&reg_dldo1>;
+	allwinner,tx-delay-ps = <700>;
+	allwinner,rx-delay-ps = <2000>;
+};
+
+&de {
+	status = "okay";
+};
+
+/* ehci0/ohci0 share PHY0 with the MUSB USB-C peripheral; leave them
+ * on the dtsi default (disabled) */
+&ehci1 {
+	status = "okay";
+};
+
+&ehci2 {
+	status = "okay";
+};
+
+/* Header USB pair (pins 18/20) */
+&ehci3 {
+	status = "okay";
+};
+
+/* PI16 is the status LED on this board, not an EMAC pin */
+&ext_rgmii_pins {
+	pins = "PI0", "PI1", "PI2", "PI3", "PI4",
+	       "PI5", "PI7", "PI8", "PI9", "PI10",
+	       "PI11", "PI12", "PI13", "PI14", "PI15";
+};
+
+&gpu {
+	status = "okay";
+	mali-supply = <&reg_dcdc1>;
+};
+
+&hdmi {
+	status = "okay";
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
+
+&i2c1 {
+	status = "disabled";
+	pinctrl-0 = <&i2c1_ph_pins>;
+	pinctrl-names = "default";
+};
+
+&i2c2 {
+	status = "disabled";
+	pinctrl-0 = <&i2c2_ph_pins>;
+	pinctrl-names = "default";
+};
+
+/* Shared between the on-board RTC and the header's I2C3 pins */
+&i2c3 {
+	status = "okay";
+	pinctrl-0 = <&i2c3_ph_pins>;
+	pinctrl-names = "default";
+
+	/* AnalogTek AT8563S, a PCF8563-compatible RTC; battery-backed via BAT54C */
+	ext_rtc: rtc@51 {
+		compatible = "haoyu,hym8563";
+		reg = <0x51>;
+		#clock-cells = <0>;
+	};
+};
+
+&i2c4 {
+	status = "disabled";
+	pinctrl-0 = <&i2c4_ph_pins>;
+	pinctrl-names = "default";
+};
+
+&ir {
+	status = "okay";
+	pinctrl-0 = <&ir_rx_pin>;
+	pinctrl-names = "default";
+};
+
+&mdio0 {
+	ext_rgmii_phy: ethernet-phy@0 {
+		/* Maxio MAE0621A-Q2C (rev 2.2 boards). Slow to come back
+		 * after a hardware reset; 100ms is not enough before it
+		 * answers MDIO again. */
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x0>;
+		reset-assert-us = <20000>;
+		reset-deassert-us = <300000>;
+		reset-gpios = <&pio 8 6 GPIO_ACTIVE_LOW>; /* PI6 */
+	};
+};
+
+/* SD card */
+&mmc0 {
+	status = "okay";
+	bus-width = <4>;
+	cd-gpios = <&pio 5 6 GPIO_ACTIVE_HIGH>;	/* PF6 */
+	cd-inverted;
+	disable-wp;
+	max-frequency = <50000000>;
+	vmmc-supply = <&reg_dldo1>;
+};
+
+/* SDIO WiFi (Seekwave VS6621S) */
+&mmc1 {
+	status = "okay";
+	bus-width = <4>;
+	keep-power-in-suspend;
+	max-frequency = <100000000>;
+	mmc-pwrseq = <&sdio_pwrseq>;
+	no-mmc;
+	no-sd;
+	non-removable;
+	vmmc-supply = <&reg_dldo1>;
+	vqmmc-supply = <&reg_aldo1>;
+
+	sdio: wifi@1 {
+		reg = <1>;
+	};
+};
+
+/* PC0 is the eMMC data strobe, unused at HS200 */
+&mmc2_pins {
+	pins = "PC1", "PC5", "PC6",
+	       "PC8", "PC9", "PC10", "PC11",
+	       "PC13", "PC14", "PC15", "PC16";
+};
+
+/* eMMC */
+&mmc2 {
+	status = "okay";
+	bus-width = <8>;
+	cap-mmc-hw-reset;
+	mmc-hs200-1_8v;
+	non-removable;
+	vmmc-supply = <&reg_dldo1>;
+	vqmmc-supply = <&reg_aldo1>;
+};
+
+&ohci1 {
+	status = "okay";
+};
+
+&ohci2 {
+	status = "okay";
+};
+
+&ohci3 {
+	status = "okay";
+};
+
+&pio {
+	vcc-pc-supply = <&reg_dldo1>;
+	vcc-pf-supply = <&reg_dldo1>;
+	vcc-pg-supply = <&reg_aldo1>;
+	vcc-ph-supply = <&reg_dldo1>;
+	vcc-pi-supply = <&reg_dldo1>;
+	vcc-pl-supply = <&reg_aldo1>;
+
+	i2c1_ph_pins: i2c1-ph-pins {
+		pins = "PH0", "PH1";
+		function = "i2c1";
+	};
+
+	i2c2_ph_pins: i2c2-ph-pins {
+		pins = "PH2", "PH3";
+		function = "i2c2";
+	};
+
+	i2c4_ph_pins: i2c4-ph-pins {
+		pins = "PH6", "PH7";
+		function = "i2c4";
+	};
+};
+
+/* The 20-pin header routes pwm1 (pin 10, PH3) and pwm2 (pin 8, PH2),
+ * shared with uart5/i2c2. Controller from the out-of-tree driver
+ * (linux/0005/0006), which takes each channel's pinctrl from the
+ * channel child; channels are consumer-less here — export via
+ * /sys/class/pwm or map in an overlay/app.
+ */
+&pwm {
+	status = "okay";
+};
+
+&pwm1 {
+	pinctrl-0 = <&pwm1_ph_pin>;
+	pinctrl-names = "default";
+};
+
+&pwm2 {
+	pinctrl-0 = <&pwm2_ph_pin>;
+	pinctrl-names = "default";
+};
+
+&r_i2c {
+	status = "okay";
+	axp313: pmic@36 {
+		compatible = "x-powers,axp313a";
+		reg = <0x36>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		/* AXP313A IRQ (pin 11) is wired only to test point TP5, not to the H618 -- no SoC interrupt */
+
+		vin1-supply = <&reg_vcc5v>;
+		vin2-supply = <&reg_vcc5v>;
+		vin3-supply = <&reg_vcc5v>;
+
+		regulators {
+			reg_aldo1: aldo1 {
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-step-delay-us = <25>;
+				regulator-final-delay-us = <50>;
+				regulator-name = "vcc-1v8-pll";
+			};
+
+			reg_dldo1: dldo1 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-step-delay-us = <25>;
+				regulator-final-delay-us = <50>;
+				regulator-name = "vcc-3v3-io";
+			};
+
+			reg_dcdc1: dcdc1 {
+				regulator-always-on;
+				regulator-min-microvolt = <810000>;
+				regulator-max-microvolt = <990000>;
+				regulator-step-delay-us = <25>;
+				regulator-final-delay-us = <50>;
+				regulator-name = "vdd-gpu-sys";
+			};
+
+			reg_dcdc2: dcdc2 {
+				regulator-always-on;
+				regulator-min-microvolt = <810000>;
+				regulator-max-microvolt = <1100000>;
+				regulator-step-delay-us = <25>;
+				regulator-final-delay-us = <50>;
+				regulator-ramp-delay = <200>;
+				regulator-name = "vdd-cpu";
+			};
+
+			reg_dcdc3: dcdc3 {
+				/* DDR3L rail; must match the 1.36 V the DRAM
+				 * was trained at (AXP_DCDC3_VOLT in U-Boot) */
+				regulator-always-on;
+				regulator-min-microvolt = <1360000>;
+				regulator-max-microvolt = <1360000>;
+				regulator-step-delay-us = <25>;
+				regulator-final-delay-us = <50>;
+				regulator-name = "vdd-dram";
+			};
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+	pinctrl-0 = <&uart0_ph_pins>;
+	pinctrl-names = "default";
+};
+
+/* Bluetooth (Seekwave VS6621S) */
+&uart1 {
+	status = "okay";
+	pinctrl-0 = <&uart1_pins>, <&uart1_rts_cts_pins>;
+	pinctrl-names = "default";
+	uart-has-rtscts;
+};
+
+&usbotg {
+	status = "okay";
+	dr_mode = "peripheral";
+};
+
+&usbphy {
+	status = "okay";
+	usb1_vbus-supply = <&reg_usb_vbus>;
+};
