# Nerves additions on top of the arm64 defconfig (kernel 6.18.y).
#
# The arm64 defconfig already has =y: MMC_SUNXI, SQUASHFS, SERIAL_8250_DW,
# PINCTRL_SUN50I_H616, SUN50I_H616_CCU, MFD_AXP20X_I2C, REGULATOR_AXP20X,
# PHY_SUN4I_USB, RTC_DRV_SUN6I, NVMEM_SUNXI_SID and the sunxi clk/pinctrl
# core. cfg80211/mac80211 are =m.

# Ethernet built in (the defconfig has stmmac as a module; the sun8i glue
# follows it)
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y

# The RGMII PHY vendor is unmarked on the board; build in the vendors
# common on H616/H618 SBCs so whichever one this is gets its delays and
# LEDs configured (generic c22 works for the rest).
CONFIG_REALTEK_PHY=y
CONFIG_MOTORCOMM_PHY=y

# GPU: open Panfrost driver (Mali G31).
CONFIG_DRM=y
CONFIG_DRM_PANFROST=m

# Thermal sensor; calibration comes from the SID efuse
CONFIG_SUN8I_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y

# Analog audio (line out on the AV jack)
CONFIG_SND_SUN4I_CODEC=m

# IR receiver
CONFIG_RC_CORE=m
CONFIG_RC_DECODERS=y
CONFIG_IR_NEC_DECODER=m
CONFIG_IR_SUNXI=m

# The application data partition is f2fs
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y

# TUN/TAP built in: standard Nerves expectation (VPNs, overlay networks)
CONFIG_TUN=y

# vintage_net's RouteManager uses policy routing. IP_ADVANCED_ROUTER is
# required for IP_MULTIPLE_TABLES to take effect (kconfig dependency —
# without it the symbol is silently dropped and route updates fail with
# "Address family not supported by protocol").
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# Watchdog must not be disarmable once Erlang heart opens it
CONFIG_SUNXI_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y

# Reboot 10s after a kernel panic (alongside the heart-armed watchdog)
CONFIG_PANIC_TIMEOUT=10

# Nerves devices must never sleep
# CONFIG_SUSPEND is not set

# squashfs rootfs read performance
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y

# Generic Nerves niceties (cf. official systems)
CONFIG_POSIX_MQUEUE=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_OF_OVERLAY=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# Plug-and-play USB peripherals as modules (zero cost until plugged in)
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_EXFAT_FS=m

# FAT short-name codepage for western-European USB sticks
CONFIG_NLS_CODEPAGE_850=y
# erlinit mounts the FAT boot partition with iocharset=ascii (the arm64
# defconfig doesn't include this NLS; without it the mount fails with
# "IO charset ascii not found")
CONFIG_NLS_ASCII=y

# Onboard WiFi/BT: Seekwave SWT6621S on SDIO (linux/0004 adds the
# vendor driver tree, patched to export modalias info, so the whole
# stack autoloads through hotplug: skw_sdio_lite from the SDIO id,
# then swt6621s_wifi and skwbt from the platform devices it creates).
# Firmware comes from package/seekwave-firmware.
CONFIG_WLAN_VENDOR_SWT6621S=m
CONFIG_SEEKWAVE_BSP_DRIVERS=y
CONFIG_SKW_SDIOHAL=m
CONFIG_SKW_BT=m
# CONFIG_SKW_USB is not set
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y

# The rev 2.2 board's Maxio MAE0621A gigabit PHY (out-of-tree driver,
# linux/0002). Its config_init is what turns on the PHY's RGMII RX clock
# output; without it the sun8i MAC's soft reset times out and the whole
# probe fails, MDIO included.
CONFIG_MAXIO_PHY=y

# GPU power domain (7010250.power-controller in the h616 dtsi). Without
# this driver the panfrost probe defers on its power-domains supplier
# until the 10s timeout and the GPU never comes up.
CONFIG_SUN50I_H6_PRCM_PPU=y

# CPU DVFS. The arm64 defconfig builds this =m, but nothing autoloads a
# cpufreq platform driver, so the CPU sits at its boot frequency
# forever. Hardware-verified: 480-1416 MHz OPPs from the speed-bin
# fuse, 0.95 V idle to 1.10 V at full load.
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y

# The rev 2.2 board's battery-backed RTC (HYM8563TS on i2c3). Aliased
# to rtc0 so it is the system timekeeper; the SoC RTC (no battery) is
# rtc1.
CONFIG_RTC_DRV_HYM8563=y

# PWM on the 20-pin header (pwm1 = pin 10/PH3, pwm2 = pin 8/PH2).
# Mainline has no H616 PWM driver; linux/0005/0006 carry Armbian's
# out-of-tree pwm-sunxi-enhance driver and DT nodes. No on-board
# consumer — exported for header users via /sys/class/pwm.
CONFIG_PWM=y
CONFIG_PWM_SUNXI_ENHANCE=y

# HDMI display: the DE33 + H616 TCON/HDMI-PHY stack from Armbian's
# patches.drm series (linux/0101-0141, Jernej Skrabec's upstream-bound
# work). Built in, like the sige5's display: the framebuffer console
# exists from early boot (console=tty1), a KMS app can take over from
# it. Built-in also resolves the planes driver's unexported symbol
# dependency on the mixer, which only links when they share an image.
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN8I_DW_HDMI=y

# The Seekwave wifi driver's log-level Kconfig choice defaults to
# DEBUG, which logs every rx/tx packet to the console. INFO keeps
# service and connection messages only.
CONFIG_SWT6621S_LOG_INFO=y

# BL31 owns the crypto engine to serve the SMCCC TRNG (see the TF-A
# tfa/patches CE TRNG driver). The kernel driver must not also bind it,
# or the two race the same task-queue registers, clocks and reset. The
# arm64 defconfig enables it as a module; turn it off.
# CONFIG_CRYPTO_DEV_SUN8I_CE is not set
